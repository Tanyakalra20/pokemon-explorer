{
  "name": "pokemon-explorer",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "assert": "^2.1.0",
    "axios": "^1.9.0",
    "browserify-zlib": "^0.2.0",
    "https-browserify": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-loader-spinner": "^6.1.6",
    "react-scripts": "5.0.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "web-vitals": "^2.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tanyakalra20/pokemon-explorer"
  },
  "author": "Tanya Kalra",
  "bugs": {
    "url": "https://github.com/Tanyakalra20/pokemon-explorer/issues"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "tailwindcss": "^3.2.7"
  },
  "webpack": {
    "resolve": {
      "fallback": {
        "http": "stream-http",
        "https": "https-browserify",
        "stream": "stream-browserify",
        "url": "url",
        "assert": "assert",
        "util": "util/",
        "zlib": "browserify-zlib"
      }
    }
  }
